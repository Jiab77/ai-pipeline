  "mammouth": {
    "name": "Mammouth AI",
    "url": "https://api.mammouth.ai/v1/chat/completions",
    "keys": "https://mammouth.ai/app/account/settings/api",
    "api": "https://info.mammouth.ai/docs/api-quick-start/",
    "models": "https://api.mammouth.ai/public/models",
