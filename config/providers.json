      "base": "https://huggingface.co/docs",
      "intro": "/inference-providers/index",
      "models": "https://huggingface.co/models?inference_provider=all",
      "chat": "/inference-providers/tasks/chat-completion",
      "images": "/inference-providers/tasks/text-to-image",
      "vision": "/inference-providers/tasks/image-text-to-text",
      "voice": "/inference-providers/tasks/automatic-speech-recognition",
      "videos": "/inference-providers/tasks/text-to-video"
    },
    "default": {
      "memory": "full",
      "model": "moonshotai/Kimi-K3",
      "image": true,
      "vision": true,
      "zdr": false
    },
    "image": {
      "mode": "native",
      "endpoint": "https://router.huggingface.co/hf-inference/models",
      "default": "stabilityai/stable-diffusion-3-medium-diffusers",
      "models": {
        "stabilityai/stable-diffusion-3-medium-diffusers": { "size_mode": "pixel" }
      },
      "output": "binary"
    }
  },
