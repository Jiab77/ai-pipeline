      "base": "https://developers.openai.com/api/docs",
      "intro": "/quickstart",
      "models": "/models",
      "files": "/guides/file-inputs",
      "chat": "/guides/text",
      "images": "/guides/image-generation",
      "vision": "/guides/images-vision",
      "voice": [
        "/guides/audio",
        "/guides/text-to-speech"
      ]
    },
    "default": {
      "memory": "index",
      "model": "gpt-6-astra",
      "image": true,
      "vision": true,
      "zdr": false
    },
    "image": {
      "mode": "native",
      "endpoint": "https://api.openai.com/v1/images/generations",
      "default": "gpt-image-2",
      "models": {
        "gpt-image-1":      { "size_mode": "size_string", "min": 1024, "max": 1536, "step": 512, "max_px": 1572864 },
        "gpt-image-1.5":    { "size_mode": "size_string", "min": 1024, "max": 1536, "step": 512, "max_px": 1572864 },
        "gpt-image-1-mini": { "size_mode": "size_string", "min": 1024, "max": 1536, "step": 512, "max_px": 1572864 },
        "gpt-image-2":      { "size_mode": "size_string", "min": 1024, "max": 3840, "step": 16, "max_px": 8294400 }
      },
      "output": "base64"
    }
  },
