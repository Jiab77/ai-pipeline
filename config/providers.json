  "huggingface": {
    "name": "Hugging Face",
    "url": "https://router.huggingface.co/v1/chat/completions",
    "keys": "https://huggingface.co/settings/tokens",
    "api": "https://huggingface.co/docs/inference-providers/providers/hf-inference",
