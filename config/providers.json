        "gpt-image-2":                    { "size_mode": "size_string", "min": 1024, "max": 3840, "step": 16, "max_px": 8294400 },
        "gemini-2.5-flash-image":         { "size_mode": "aspect_ratio" },
        "gemini-3.1-flash-image-preview": { "size_mode": "aspect_ratio" },
        "gemini-3.1-flash-lite-image":    { "size_mode": "aspect_ratio" },
        "gemini-3-pro-image-preview":     { "size_mode": "aspect_ratio" }
      },
      "output": "base64"
    }
