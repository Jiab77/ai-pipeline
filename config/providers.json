  "openai": {
    "name": "OpenAI",
    "url": "https://api.openai.com/v1/responses",
    "keys": "https://platform.openai.com/api-keys",
    "api": "https://developers.openai.com/api/reference/overview",
    "models": "https://api.openai.com/v1/models",
