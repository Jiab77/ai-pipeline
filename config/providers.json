{
  "anthropic": {
    "name": "Anthropic",
    "version": "2023-06-01",
    "url": "https://api.anthropic.com/v1/messages",
    "keys": "https://platform.claude.com/settings/keys",
    "api": "https://platform.claude.com/docs/en/api/messages/create",
    "models": "https://api.anthropic.com/v1/models",
    "docs": {
      "base": "https://platform.claude.com/docs",
      "intro": "/en/get-started",
      "models": "/en/api/models/list",
      "files": [
        "/en/api/http/beta/files/upload",
        "/en/api/http/beta/files/list",
        "/en/api/http/beta/files/download",
        "/en/api/http/beta/files/retrieve_metadata",
        "/en/api/http/beta/files/delete"
      ]
    },
    "default": {
      "memory": "index",
      "model": "claude-fable-5-1",
      "max_tokens": 128000,
      "image": false,
      "vision": true,
      "zdr": false
    }
  },
  "cyberneurova": {
    "name": "CyberNeurova",
    "url": "https://api.cyberneurova.ai/v1/chat/completions",
    "keys": "https://platform.cyberneurova.com/keys",
    "api": "https://cyberneurova.com/api",
    "models": "https://api.cyberneurova.ai/v1/models",
    "docs": {
      "base": "https://cyberneurova.com/docs",
      "intro": "/getting-started",
      "models": "/models",
      "chat": "/chat",
      "images": "/imagine",
      "vision": "/vision",
      "voice": "/voice",
      "videos": "/imagine"
    },
    "default": {
      "memory": "index",
      "model": "cyberneurova-qwen3.8",
      "image": true,
      "vision": true,
      "zdr": false
    },
    "image": {
      "mode": "native",
      "endpoint": "https://api.cyberneurova.ai/v1/images/generations",
      "default": "artemis-img",
      "models": {
        "artemis-img": { "size_mode": "pixel" }
      },
      "output": "url"
    }
  },
  "deepseek": {
    "name": "DeepSeek",
    "url": "https://api.deepseek.com/chat/completions",
